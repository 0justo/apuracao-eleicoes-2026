# ==============================================================================
# Variáveis de Ambiente — Apuração 2º Turno (Eleições 2026 — 25/10/2026)
# Copie para .env antes de executar em produção
# ==============================================================================

# --- Fonte Oficial do TSE (Resolução TSE nº 23.751/2026, arts. 264 a 269) ---
TSE_BASE_URL=https://resultados.tse.jus.br
TSE_SIM_URL=https://resultados-sim.tse.jus.br
TSE_ENVIRONMENT=oficial
TSE_CYCLE=ele2026

# Modo de operação: "live" (produção 25/10/2026), "sim_2026" (simulação progressiva), "replay_2022"
TSE_SOURCE_MODE=live

# Cadência de coleta (mínimo 45–60s por arquivo com If-None-Match / If-Modified-Since)
TSE_POLL_INTERVAL_SECONDS=60
TSE_MIN_FILE_INTERVAL_SECONDS=45.0
TSE_MAX_CONCURRENT_REQUESTS=4
TSE_REQUEST_TIMEOUT_SECONDS=12.0

# --- Armazenamento Local e Publicação de Snapshots ---
DB_PATH=backend/data/apuracao_2026.sqlite3
SNAPSHOT_DIR=public/snapshots
BASELINE_1T_PATH=backend/data/baseline_1t_2026.json

# --- Feature Flags (podem ser desligadas sem novo deploy do frontend) ---
FEATURE_REFERENCE_SCENARIO=false
FEATURE_NARRATOR=true
FEATURE_REPLAY=true

# --- Alertas Operacionais (> 5 min sem atualização entre 17h e 23h59) ---
STALE_WARNING_SECONDS=180
STALE_ALERT_SECONDS=300
ALERT_WEBHOOK_URL=

# --- Segurança e Rate Limiting ---
CORS_ORIGINS=["*"]
RATE_LIMIT_REQUESTS_PER_MINUTE=240
